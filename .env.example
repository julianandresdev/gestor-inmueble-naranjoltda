# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env

# Credenciales de PostgreSQL consumidas por docker-compose.yml.
# El servicio `postgres` las lee de aquí y el puerto 5432 se enlaza
# únicamente a 127.0.0.1 (desarrollo).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="cambia-esta-contrasena"

# URL de conexión a PostgreSQL.
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD de arriba:
DATABASE_URL="postgresql://postgres:cambia-esta-contrasena@localhost:5432/gestor_inmueble?schema=public"

# Secreto usado por Auth.js para firmar tokens de sesión JWT.
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplaza-por-un-secreto-generado"

# Credenciales del administrador inicial (usado solo por el seed):
#   pnpm seed:admin
ADMIN_NOMBRE="Administrador"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-contrasena"

# Contraseña del usuario asesor de desarrollo (usado solo por el seed).
# El script `pnpm seed:asesor` falla si esta variable no está definida:
ASESOR_PASSWORD="cambia-esta-contrasena"

# Entorno de la aplicación: development | production
NODE_ENV="development"

# Zona horaria del proceso Node. Fija Bogotá (UTC-5) para todas las
# operaciones de fecha/hora del servidor (new Date(), toLocaleString(),
# Intl.DateTimeFormat sin timeZone explícito). En producción debe estar
# también definida en las env vars del proyecto en Vercel.
TZ="America/Bogota"

# Telegram actualizaciones (tickets)
TELEGRAM_BOT_TOKEN="tu-token"
TELEGRAM_CHAT_ID="tu-id"
